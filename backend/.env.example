# 医院工时统计系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ===== Django配置 =====
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== 数据库配置 =====
DB_ENGINE=django.db.backends.mysql
DB_NAME=hospital_db
DB_USER=hospital_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# ===== Redis配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== 微信小程序配置 =====
WECHAT_APP_ID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-secret

# ===== 地理围栏配置 =====
HOSPITAL_LATITUDE=39.9042
HOSPITAL_LONGITUDE=116.4074
GEOFENCE_RADIUS=200

# ===== 文件上传 =====
MEDIA_ROOT=/var/www/hospital/media
MEDIA_URL=/media/
