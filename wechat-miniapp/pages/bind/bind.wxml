<!--pages/bind/bind.wxml-->
<!-- 账号绑定页面 -->
<view class="container">
    <!-- 顶部图标 -->
    <view class="header">
        <view class="logo">🏥</view>
        <text class="title">绑定医院账号</text>
        <text class="subtitle">首次登录需要绑定您的工号</text>
    </view>

    <!-- 绑定表单 -->
    <view class="form-section">
        <van-cell-group inset>
            <van-field
                value="{{ empCode }}"
                label="工号"
                placeholder="请输入您的工号"
                required
                clearable
                bindinput="onEmpCodeInput"
            />
            <van-field
                value="{{ phone }}"
                label="手机号"
                placeholder="可选，用于接收通知"
                type="number"
                maxlength="11"
                clearable
                bindinput="onPhoneInput"
            />
        </van-cell-group>
    </view>

    <!-- 提示信息 -->
    <view class="tips">
        <view class="tip-item">
            <text class="tip-icon">💡</text>
            <text>工号请咨询科室负责人或人事部门</text>
        </view>
        <view class="tip-item">
            <text class="tip-icon">🔒</text>
            <text>绑定后可使用微信直接登录</text>
        </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
        <van-button 
            type="primary" 
            block 
            round
            loading="{{ loading }}"
            disabled="{{ loading }}"
            bindtap="submitBind"
        >
            确认绑定
        </van-button>
        
        <van-button 
            type="default" 
            block 
            plain
            round
            custom-class="back-button"
            bindtap="goBack"
        >
            返回
        </van-button>
    </view>

    <!-- 底部说明 -->
    <view class="footer">
        <text>如有问题请联系信息科</text>
    </view>
</view>
