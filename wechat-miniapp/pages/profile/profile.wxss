/* pages/profile/profile.wxss */
/* 个人中心页面样式 */

.container {
    padding: 20rpx;
    background: #f5f5f5;
    min-height: 100vh;
}

/* 用户卡片 */
.user-card {
    background: linear-gradient(135deg, #409EFF 0%, #66B1FF 100%);
    border-radius: 20rpx;
    padding: 40rpx 30rpx;
    color: #fff;
}

.user-header {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48rpx;
    font-weight: bold;
}

.user-info {
    flex: 1;
}

.user-name {
    font-size: 40rpx;
    font-weight: bold;
    display: block;
}

.user-code {
    font-size: 26rpx;
    opacity: 0.9;
    margin-top: 8rpx;
    display: block;
}

.user-tags {
    display: flex;
    gap: 12rpx;
    margin-top: 16rpx;
}

.tag {
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
}

.tag.dept {
    background: rgba(255, 255, 255, 0.2);
}

.tag.category {
    background: rgba(255, 255, 255, 0.3);
}

.user-meta {
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.job-title {
    font-size: 26rpx;
    opacity: 0.9;
}

/* 统计区域 */
.stats-section {
    background: #fff;
    border-radius: 16rpx;
    margin-top: 20rpx;
    padding: 30rpx;
}

.stats-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
}

.period-switch {
    display: flex;
    background: #f5f5f5;
    border-radius: 20rpx;
    padding: 4rpx;
}

.period-item {
    padding: 10rpx 24rpx;
    font-size: 24rpx;
    color: #999;
    border-radius: 16rpx;
}

.period-item.active {
    background: #409EFF;
    color: #fff;
}

.stats-grid {
    display: flex;
    justify-content: space-around;
}

.stat-item {
    text-align: center;
}

.stat-value {
    font-size: 44rpx;
    font-weight: bold;
    color: #333;
    display: block;
}

.stat-value.highlight {
    color: #F56C6C;
}

.stat-label {
    font-size: 24rpx;
    color: #999;
    margin-top: 8rpx;
    display: block;
}

/* 菜单区域 */
.menu-section {
    margin-top: 20rpx;
}

.menu-section .section-title {
    padding: 20rpx 30rpx;
}

/* 退出登录 */
.logout-section {
    margin-top: 40rpx;
    padding: 0 30rpx;
}

/* 版本信息 */
.version-info {
    text-align: center;
    padding: 40rpx 0;
    color: #ccc;
    font-size: 24rpx;
}
