/* pages/punch/punch.wxss */
/* 打卡页面样式 */

.container {
    padding: 30rpx;
    background: linear-gradient(180deg, #409EFF 0%, #f5f5f5 40%);
    min-height: 100vh;
}

/* 时间显示 */
.time-section {
    text-align: center;
    padding: 60rpx 0 40rpx;
}

.current-time {
    font-size: 80rpx;
    font-weight: bold;
    color: #fff;
    display: block;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.current-date {
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 10rpx;
    display: block;
}

/* 排班信息 */
.roster-info {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 16rpx;
    padding: 24rpx 30rpx;
    margin-bottom: 20rpx;
    text-align: center;
}

.roster-info.no-roster {
    color: #999;
}

.roster-label {
    color: #666;
    font-size: 28rpx;
}

.roster-value {
    color: #409EFF;
    font-weight: bold;
    font-size: 28rpx;
}

.roster-time {
    color: #999;
    font-size: 24rpx;
}

/* 位置信息 */
.location-section {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx 30rpx;
    margin-bottom: 20rpx;
}

.location-status {
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.location-icon {
    font-size: 32rpx;
}

.location-text {
    flex: 1;
    font-size: 28rpx;
    color: #333;
}

.refresh-btn {
    color: #409EFF;
    font-size: 26rpx;
}

.distance-info {
    margin-top: 16rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #eee;
}

.in-range-text {
    color: #67C23A;
    font-size: 26rpx;
}

.out-range-text {
    color: #E6A23C;
    font-size: 26rpx;
}

.location-error {
    margin-top: 20rpx;
    text-align: center;
}

/* 打卡区域 */
.punch-section {
    display: flex;
    gap: 20rpx;
}

.punch-card {
    flex: 1;
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.punch-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.punch-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
}

.punch-status {
    font-size: 24rpx;
    color: #999;
}

.punch-status.done {
    color: #67C23A;
}

.punch-time {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 20rpx;
}

.punch-button {
    width: 100%;
}

/* 打卡记录 */
.records-section {
    margin-top: 30rpx;
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
}

.record-list {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.record-item {
    display: flex;
    align-items: center;
    padding: 20rpx;
    background: #f9f9f9;
    border-radius: 12rpx;
}

.record-type {
    padding: 8rpx 16rpx;
    border-radius: 8rpx;
    font-size: 24rpx;
    font-weight: bold;
}

.record-type.type-in {
    background: #E6F7FF;
    color: #409EFF;
}

.record-type.type-out {
    background: #F0F9EB;
    color: #67C23A;
}

.record-info {
    flex: 1;
    margin-left: 20rpx;
}

.record-time {
    display: block;
    font-size: 28rpx;
    color: #333;
}

.record-source {
    display: block;
    font-size: 22rpx;
    color: #999;
    margin-top: 4rpx;
}

.record-status {
    font-size: 24rpx;
    padding: 6rpx 12rpx;
    border-radius: 6rpx;
}

.record-status.normal {
    background: #F0F9EB;
    color: #67C23A;
}

.record-status.abnormal {
    background: #FEF0F0;
    color: #F56C6C;
}
