/* pages/roster/roster.wxss */
/* 排班页面样式 */

.container {
    padding: 20rpx;
    background: #f5f5f5;
    min-height: 100vh;
}

/* 页面标题 */
.page-header {
    padding: 20rpx 0 30rpx;
}

.page-header .title {
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
    display: block;
}

.page-header .subtitle {
    font-size: 24rpx;
    color: #999;
    margin-top: 8rpx;
    display: block;
}

/* 日历容器 */
.calendar-wrapper {
    background: #fff;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 班次图例 */
.legend-bar {
    display: flex;
    justify-content: center;
    gap: 40rpx;
    padding: 20rpx;
    background: #fff;
    margin-top: 20rpx;
    border-radius: 16rpx;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 10rpx;
    font-size: 24rpx;
    color: #666;
}

.legend-dot {
    width: 20rpx;
    height: 20rpx;
    border-radius: 50%;
}

/* 详情卡片 */
.detail-card {
    background: #fff;
    border-radius: 16rpx;
    margin-top: 20rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 30rpx;
    border-bottom: 1rpx solid #eee;
}

.detail-date {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.detail-weekday {
    font-size: 26rpx;
    color: #409EFF;
}

.detail-body {
    padding: 30rpx;
}

.shift-badge {
    display: inline-block;
    padding: 12rpx 30rpx;
    border-radius: 30rpx;
    color: #fff;
    font-size: 28rpx;
    font-weight: bold;
    margin-bottom: 24rpx;
}

.shift-time {
    display: flex;
    justify-content: space-between;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
}

.time-label {
    font-size: 28rpx;
    color: #666;
}

.time-value {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.cross-day-tag {
    margin-top: 20rpx;
    text-align: center;
}

.cross-day-tag text {
    display: inline-block;
    padding: 8rpx 20rpx;
    background: #FEF0F0;
    color: #F56C6C;
    font-size: 24rpx;
    border-radius: 20rpx;
}

.detail-empty {
    padding: 40rpx 0;
}

/* 操作栏 */
.action-bar {
    margin-top: 30rpx;
    padding: 0 20rpx;
}

/* 加载状态 */
.loading-overlay {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

/* 有排班的日期样式 */
.has-roster {
    position: relative;
}

.has-roster::after {
    content: '';
    position: absolute;
    bottom: 6rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 8rpx;
    height: 8rpx;
    background: #409EFF;
    border-radius: 50%;
}
